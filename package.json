{
  "name": "wordworld",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "admin": "tsx server/admin.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app server tests *.ts *.json *.md",
    "db:migrate": "tsx server/admin.ts migrate"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "next": "^15.5.12",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "word-list": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "better-sqlite3": "^11.10.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": "22.x"
  }
}
